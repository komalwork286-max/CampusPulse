<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Issue Status"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E3A8A"
            android:layout_marginBottom="20dp" />

        <!-- Issue ID -->
        <EditText
            android:id="@+id/edtIssueId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Issue ID"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Status"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/rgStatus"
            android:orientation="vertical">

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/rbPending"
                android:text="Pending" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/rbInProgress"
                android:text="In Progress" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/rbResolved"
                android:text="Resolved" />
        </RadioGroup>

        <!-- Department -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assign Department"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Spinner
            android:id="@+id/spDepartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <!-- Update Button -->
        <Button
            android:id="@+id/btnUpdateIssue"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Update Issue"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="#4F46E5" />

    </LinearLayout>
</ScrollView>
