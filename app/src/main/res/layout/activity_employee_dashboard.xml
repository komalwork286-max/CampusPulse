<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1E3A8A"
        android:text="Employee Dashboard"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <!-- Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="356dp"
        android:layout_weight="1"
        android:columnCount="2"
        android:padding="16dp"
        android:rowCount="2">

        <!-- Campus Issues -->
        <LinearLayout
            android:id="@+id/cardCampusIssues"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/card1"
            android:gravity="center"
            android:orientation="vertical"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧾"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Campus Issues"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- My Work -->
        <LinearLayout
            android:id="@+id/cardMyWork"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/card2"
            android:gravity="center"
            android:orientation="vertical"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛠"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Work"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Update Status -->
        <LinearLayout
            android:id="@+id/cardUpdateStatus"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/card3"
            android:gravity="center"
            android:orientation="vertical"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update Status"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Notifications -->
        <LinearLayout
            android:id="@+id/cardNotifications"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/card4"
            android:gravity="center"
            android:orientation="vertical"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notifications"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </GridLayout>

    <!-- Profile Button -->
    <Button
        android:id="@+id/btnProfile"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="👤 View Profile"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/bg_button"
        android:layout_margin="16dp"/>
</LinearLayout>
